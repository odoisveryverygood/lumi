GEMINI_API_KEY=
# Optional: pin a model your account can access. Otherwise the server discovers a premium model.
# GEMINI_MODEL=gemini-4-argon
# Priority uses the Interactions API and keeps the selected model. Google may
# serve Standard instead; completed responses report the actual tier observed.
GEMINI_TRANSPORT=interactions
GEMINI_SERVICE_TIER=standard
# Argon reasoning: low for targeted extraction; medium for normal design/review.
GEMINI_THINKING_LEVEL=medium
# Opt-in sanitized timing/token reports in server logs; never logs input or keys.
# FLARE_LOG_INFERENCE=1
