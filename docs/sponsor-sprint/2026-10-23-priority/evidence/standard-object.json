":"cylinder","position":[24,1,2],"size":[13.5,48,13.5],"rotation":[0,0,90],"color":"#D89C24","metalness":0.5,"roughness":0.3},{"kind":"cylinder","position":[24,1,2],"size":[13.7,14,13.7],"rotation":[0,0,90],"color":"#1E2226","roughness":0.4},{"kind":"cylinder","position":[49,1,2],"size":[5,2,5],"rotation":[0,0,90],"color":"#D0D6DC","metalness":0.85,"roughness":0.2},{"kind":"box","position":[-50,1,0.5],"size":[2,10,12],"color":"#C8D0D8","metalness":0.85,"roughness":0.2},{"kind":"box","position":[50,1,0.5],"size":[2,10,12],"color":"#C8D0D8","metalness":0.85,"roughness":0.2},{"kind":"box","position":[0,-6.5,1],"size":[100,2.5,16],"color":"#B84712","metalness":0.1,"roughness":0.45}],"specs":{"Cells":"2 x AA (LR6) 1.5V in series","Nominal Pack Voltage":"3.0 V DC","Contacts":"Nickel-plated spring steel"},"connections":[{"partId":"main-pcb","label":"Positive and negative power bus"},{"partId":"rear-shell","label":"Lower rear battery trough"}],"assemblyId":"asm-controls-power"}],"steps":[{"title":"Split Burnt-Orange Enclosure & Corner Bumpers","description":"Inspect the split burnt-orange housing, hinged clear-window cassette door, and the four dark TPU corner bumpers that protect the portable player against drops.","partIds":["rear-shell","front-door","corner-bumpers"]},{"title":"Compact Cassette & Dual Tape Reels","description":"Through the acrylic window, the removable compact cassette engages the six-spline left supply reel and right take-up reel on the transport deck.","partIds":["compact-cassette","supply-reel","takeup-reel","deck-chassis"]},{"title":"Capstan, Pinch Roller & Stereo Head Engagement","description":"Pressing the top Play button advances the head bridge so the stereo permalloy head contacts the tape and the rubber pinch roller presses the tape against the spinning capstan shaft.","partIds":["play-stop-buttons","capstan-pinch-head","compact-cassette"]},{"title":"DC Micro Motor & Belt Drive","description":"A governed 3V DC motor spins a stepped brass pulley coupled by a rubber belt to the brass capstan flywheel and take-up reel clutch.","partIds":["drive-motor","deck-chassis","takeup-reel"]},{"title":"Analog Audio Chain & Dual-AA Power","description":"The dual-AA battery bay powers the preamplifier PCB, where signals from the tape head are contoured, adjusted by the side volume thumbwheel, and routed to the 3.5mm headphone socket.","partIds":["battery-compartment","main-pcb","volume-wheel","headphone-jack"]}],"source":"gemini","model":"gemini-4-argon","assemblies":[{"id":"asm-enclosure","name":"Outer Enclosure & Door","partIds":["rear-shell","front-door","corner-bumpers"]},{"id":"asm-transport","name":"Tape Transport & Drive","partIds":["deck-chassis","drive-motor","supply-reel","takeup-reel","capstan-pinch-head","compact-cassette"]},{"id":"asm-controls-power","name":"Electronics, Controls & Power","partIds":["main-pcb","play-stop-buttons","volume-wheel","headphone-jack","battery-compartment"]}],"relationships":[{"id":"rel-motor-takeup","from":"drive-motor","to":"takeup-reel","type":"mechanical","description":"Stepped brass motor pulley drives the take-up reel and flywheel via an elastomer belt."},{"id":"rel-buttons-head","from":"play-stop-buttons","to":"capstan-pinch-head","type":"mechanical","description":"Depressing the Play button slides the stereo head and pinch roller forward against the tape and capstan."},{"id":"rel-head-pcb","from":"capstan-pinch-head","to":"main-pcb","type":"electrical","description":"Shielded head leads carry left/right microvolt magnetic flux signals to the preamplifier IC."},{"id":"rel-battery-pcb","from":"battery-compartment","to":"main-pcb","type":"electrical","description":"Two series AA cells deliver 3.0V DC power to the amplifier and motor regulator circuit."},{"id":"rel-volume-pcb","from":"volume-wheel","to":"main-pcb","type":"electrical","description":"Dual-gang rotary thumbwheel attenuates the preamplified stereo signal prior to the headphone driver."},{"id":"rel-pcb-jack","from":"main-pcb","to":"headphone-jack","type":"electrical","description":"Amplified stereo audio channels feed the tip and ring contacts of the 3.5mm headphone socket."},{"id":"rel-shell-chassis","from":"rear-shell","to":"deck-chassis","type":"contains","description":"Rear burnt-orange shell houses and supports the stamped steel transport chassis."}],"mechanisms":[{"id":"tape-play-transport","name":"Play Engagement & Reel Transport","description":"Depresses the Play key, slides the stereo head and pinch roller bridge into the cassette opening, and rotates the motor pulley and both tape reels.","duration":5,"motion":"press-release","tracks":[{"partId":"play-stop-buttons","translation":[0,-2,2.8]},{"partId":"capstan-pinch-head","translation":[0,0,4.2]},{"partId":"supply-reel","rotation":[0,-360,0]},{"partId":"takeup-reel","rotation":[0,-420,0]},{"partId":"drive-motor","rotation":[0,1440,0]}],"stages":[{"at":0,"title":"Transport Idle (Stop)","description":"Play key is raised and the head bridge is retracted clear of the cassette shell.","partIds":["play-stop-buttons","capstan-pinch-head"]},{"at":0.25,"title":"Play Key Latched & Head Engaged","description":"Top Play button depresses, sliding the stereo head and pinch roller into contact with the magnetic tape and capstan.","partIds":["play-stop-buttons","capstan-pinch-head","compact-cassette"]},{"at":0.7,"title":"Constant-Speed Tape Transport","description":"DC drive motor spins the belt drive while the supply and take-up reels wind the magnetic tape across the playback head.","partIds":["drive-motor","supply-reel","takeup-reel"]},{"at":1,"title":"Stop Release & Return","description":"Mechanism unlatches, retracting the pinch roller and stereo head to rest.","partIds":["play-stop-buttons","capstan-pinch-head"]}]}],"capabilities":["Mechanical belt-driven tape transport","Magnetic stereo tape head readout","Thumbwheel analog volume attenuation","3.5mm stereo headphone output","3V DC dual-AA battery operation"]}