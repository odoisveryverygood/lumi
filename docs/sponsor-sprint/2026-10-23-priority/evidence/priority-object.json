ription":"Two AA cells in series supply 3.0 V DC to the audio preamplifier and motor governor on the main PCB."},{"id":"rel-pcb-motor","from":"main-pcb","to":"drive-motor","type":"electrical","description":"Regulated DC current from the governor circuit drives the brushed micro motor at steady speed."},{"id":"rel-motor-capstan","from":"drive-motor","to":"capstan-pinch-assembly","type":"mechanical","description":"The motor pulley drives the heavy capstan flywheel via a flat elastomeric belt."},{"id":"rel-motor-takeup","from":"drive-motor","to":"takeup-reel-assembly","type":"mechanical","description":"Belt and slip-clutch gearing rotate the take-up reel spindle to wind slack tape."},{"id":"rel-buttons-carriage","from":"control-buttons","to":"head-carriage","type":"mechanical","description":"Depressing Play slides the head carriage and pinch roller forward into the cassette shell."},{"id":"rel-head-pcb","from":"head-carriage","to":"main-pcb","type":"data","description":"Low-level stereo magnetic flux signals from the permalloy head travel to the equalization preamplifier."},{"id":"rel-pcb-jack","from":"main-pcb","to":"volume-jack-module","type":"electrical","description":"Amplified stereo audio passes through the dual-gang thumbwheel potentiometer to the 3.5 mm headphone socket."},{"id":"rel-door-cassette","from":"cassette-door","to":"cassette-tape","type":"contains","description":"The hinged door and transparent window retain the compact cassette over the reel spindles."}],"mechanisms":[{"id":"tape-play-transport","name":"Play Engagement & Reel Transport","description":"Depressing the Play control advances the stereo head carriage toward the cassette ribbon while spinning the drive motor, capstan flywheel, and both tape reel spindles.","duration":4,"motion":"linear","tracks":[{"partId":"control-buttons","translation":[0,0,3.5]},{"partId":"head-carriage","translation":[-3.5,0,0]},{"partId":"drive-motor","rotation":[0,-1440,0]},{"partId":"capstan-pinch-assembly","rotati