t Feet","description":"Install the hollow aluminum thighs with internal knee timing belts, then attach the carbon-fiber lower shanks and spherical elastomer feet.","partIds":["thigh-fl","shank-fl","thigh-fr","shank-fr","thigh-rl","shank-rl","thigh-rr","shank-rr"]}],"source":"gemini","model":"gemini-4-argon","relationships":[{"id":"rel-battery-chassis","from":"battery-pack","to":"chassis-frame","type":"mechanical","description":"Slides and latches into the ventral battery bay of the main spine chassis."},{"id":"rel-battery-compute","from":"battery-pack","to":"compute-deck","type":"electrical","description":"Delivers 48V high-current bus power and BMS telemetry to the power distribution deck."},{"id":"rel-compute-chassis","from":"compute-deck","to":"chassis-frame","type":"contains","description":"Mounted along the upper structural spine beneath the dorsal shell."},{"id":"rel-shell-chassis","from":"top-shell","to":"chassis-frame","type":"mechanical","description":"Encloses the upper electronics bay and provides front/rear carry handles."},{"id":"rel-lidar-shell","from":"lidar-turret","to":"top-shell","type":"mechanical","description":"Bolts onto the dorsal armor deck for unobstructed 360-degree scanning."},{"id":"rel-lidar-compute","from":"lidar-turret","to":"compute-deck","type":"data","description":"Streams 3D point-cloud packets over Gigabit Ethernet to the AI compute module."},{"id":"rel-head-chassis","from":"head-module","to":"chassis-frame","type":"mechanical","description":"Attaches to the forward neck collar of the spine chassis."},{"id":"rel-head-compute","from":"head-module","to":"compute-deck","type":"data","description":"Sends synchronized stereo depth frames over MIPI-CSI/USB3 to the onboard computer."},{"id":"rel-compute-hip-fl","from":"compute-deck","to":"hip-fl","type":"data","description":"1 kHz FDCAN torque/position control loop and 48V power feed."},{"id":"rel-compute-hip-fr","from":"compute-deck","to":"hip-fr","type":"data","description":"1 kHz FDCA