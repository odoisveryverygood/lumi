ry-body","name":"Upholstered Sofa Body & Cushions","partIds":["upholstered-plinth-deck","seat-cushions","backrest-frame","back-cushions","left-armrest","right-smart-armrest"]},{"id":"asm-smart-electronics","name":"ESP32 Smart Control & Sensing System","partIds":["underframe-electronics-tray","esp32-controller-board","dc-buck-power-module","seat-occupancy-sensors","armrest-control-panel","underglow-led-strip"]}],"relationships":[{"id":"rel-frame-slats","from":"iron-base-frame","to":"spring-slat-deck","type":"mechanical","description":"Fourteen spring-steel slats bolt across the front and rear wrought-iron rails."},{"id":"rel-slats-plinth","from":"spring-slat-deck","to":"upholstered-plinth-deck","type":"mechanical","description":"The upholstered plinth deck rests on and encloses the steel slat suspension."},{"id":"rel-plinth-fsr","from":"upholstered-plinth-deck","to":"seat-occupancy-sensors","type":"contains","description":"The three FSR occupancy sensor mats lie flat on the top surface of the plinth deck."},{"id":"rel-fsr-cushions","from":"seat-occupancy-sensors","to":"seat-cushions","type":"mechanical","description":"The three seat cushions rest directly above the FSR mats to transfer occupant weight."},{"id":"rel-frame-backrest","from":"iron-base-frame","to":"backrest-frame","type":"mechanical","description":"Four iron brackets bolt the backrest spine to the rear tubular iron rail."},{"id":"rel-backrest-pillows","from":"backrest-frame","to":"back-cushions","type":"mechanical","description":"Three tufted backrest pillows rest against the angled backrest shell."},{"id":"rel-frame-left-arm","from":"iron-base-frame","to":"left-armrest","type":"mechanical","description":"Left structural armrest bolts to the left iron side rail."},{"id":"rel-frame-right-arm","from":"iron-base-frame","to":"right-smart-armrest","type":"mechanical","description":"Right smart armrest bolts to the right iron side rail."},{"id":"rel-arm-dock","from":"right-smart-armrest","to":"armrest-control-panel","type":"contains","description":"The brushed aluminum touch and USB-C dock sits flush inside the top recess of the right armrest."},{"id":"rel-frame-tray","from":"iron-base-frame","to":"underframe-electronics-tray","type":"mechanical","description":"The ventilated iron electronics tray mounts beneath the front and center crossbars."},{"id":"rel-tray-esp32","from":"underframe-electronics-tray","to":"esp32-controller-board","type":"contains","description":"Brass standoffs secure the ESP32-WROOM-32 controller PCB inside the underframe tray."},{"id":"rel-tray-power","from":"underframe-electronics-tray","to":"dc-buck-power-module","type":"contains","description":"The isolated 24V buck power module mounts beside the ESP32 PCB inside the tray."},{"id":"rel-power-esp32","from":"dc-buck-power-module","to":"esp32-controller-board","type":"electrical","description":"Supplies regulated 5V logic power and 12V lighting power to the ESP32 carrier board."},{"id":"rel-power-dock","from":"dc-buck-power-module","to":"armrest-control-panel","type":"electrical","description":"Supplies DC power to the armrest USB-C PD ports and Qi wireless charger."},{"id":"rel-fsr-esp32","from":"seat-occupancy-sensors","to":"esp32-controller-board","type":"data","description":"Analog ribbon harness routes three seat-occupancy pressure signals to the ESP32 ADC channels."},{"id":"rel-dock-esp32","from":"armrest-control-panel","to":"esp32-controller-board","type":"data","description":"I2C harness connects the armrest capacitive touch buttons and status ring to the ESP32."},{"id":"rel-esp32-led","from":"esp32-controller-board","to":"underglow-led-strip","type":"data","description":"ESP32 digital RMT/PWM output drives the front addressable RGBW underglow diffuser bar."},{"id":"rel-frame-led","from":"iron-base-frame","to":"underglow-led-strip","type":"mechanical","description":"The aluminum LED diffuser channel clips to the underside of the front wrought-iron rail."}],"capabilities":["Wi-Fi & BLE smart